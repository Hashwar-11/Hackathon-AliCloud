{
  "hosting": [
    {
      "site": "etd-platform-pk",
      "public": "frontend",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/*.bak",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "etd-disco-sandbox-pk",
      "public": "sandbox_frontend",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/*.bak",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
