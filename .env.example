# ---------------------------------------------------------------------------
# ETD (Electricity Theft Detection) Platform — Environment Variables Template
# ---------------------------------------------------------------------------

# Backend API Configuration
ETD_API_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Database Persistence
# Default uses local SQLite; set PostgreSQL URL for production / AliCloud ApsaraDB RDS
DATABASE_URL=sqlite:///./etd.db
# DATABASE_URL=postgresql://etd_user:password@localhost:5432/etd_db

# Model Paths & Configuration
CONFIG_PATH=config/config.yaml
BENCHMARK_RESULTS_PATH=experiments_results/benchmark_results.json
CUSTOMERS_JSON_PATH=data/customer_contexts.json
PAKISTAN_TARGET_PATH=data/raw/pakistan/pakistan_target.csv

# Alibaba Cloud / Qwen Intelligence Assistant (Optional)
# If provided, enables real-time AI investigative briefing notes via DashScope
# DASHSCOPE_API_KEY=your_alibaba_cloud_dashscope_api_key_here
# DASHSCOPE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# QWEN_MODEL=qwen-plus
